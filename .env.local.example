# Apify API token — required for fetching comments via Apify Actors
# Get yours at https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token_here

# OpenRouter API key — required for AI analysis
# Get yours at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional: override the AI model used for analysis
# Default: openai/gpt-4o-mini (fast and cheap)
# OPENROUTER_MODEL=openai/gpt-4o-mini
